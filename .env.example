# ═══════════════════════════════════════════════════════════════════════
# Attendance Middleware — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://attendance:change_this_password@db:5432/attendance_db

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── Security ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_in_production
API_KEY_SALT=change_this_too

# ── Application ───────────────────────────────────────────────────────
ENV=development
TZ=Asia/Jakarta

# ── ADMS ──────────────────────────────────────────────────────────────
ADMS_SERVER_URL=
ADMS_SERIAL_NUMBER=
ADMS_DEVICE_NAME=AttendanceMiddleware

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Performance ───────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
