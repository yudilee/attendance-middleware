# ═══════════════════════════════════════════════════════════════════════
# Attendance Middleware — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Portainer deployment: set these environment variables in the
# container's environment settings. The application will use them
# automatically.
# ═══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
# The password is set via DB_PASSWORD env var (see docker-compose.yml)
DATABASE_URL=postgresql://attendance:${DB_PASSWORD:-change_this_password}@db:5432/attendance_db

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── Security ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=                    # REQUIRED. Set this in Portainer!
API_KEY_SALT=                      # REQUIRED. Set this in Portainer!
SECRET_KEY=                        # Set this in Portainer!
ENCRYPTION_KEY=                    # Set this in Portainer!

# ── Application ───────────────────────────────────────────────────────
ENV=production
TZ=Asia/Jakarta

# ── ADMS ──────────────────────────────────────────────────────────────
ADMS_SERVER_URL=
ADMS_SERIAL_NUMBER=
ADMS_DEVICE_NAME=AttendanceMiddleware

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Performance ───────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
